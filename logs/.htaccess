# The audit log must never be served over the web.
# Effective on Apache/LiteSpeed. On nginx this file is ignored, which is why the
# log files are named *.log.php and begin with a "<?php exit; ?>" guard line.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
